# ========================================
# Ollama 本地模型配置（推荐）
# ========================================

# 启用 Ollama 本地模型
VITE_USE_OLLAMA=true

# Ollama 服务地址（默认使用代理 /ollama -> http://localhost:11434）
# 开发环境使用代理避免跨域，生产环境直接连接
VITE_OLLAMA_URL=/ollama

# 使用的模型名称（确保已下载: ollama pull qwen:1.8b）
# 可用模型: qwen:1.8b, llama3.2, phi4 等
VITE_OLLAMA_MODEL=qwen:1.8b

# ========================================
# Dify API 配置（可选，如果要使用 Dify）
# ========================================

# Dify API 基础URL
VITE_DIFY_API_BASE_URL=http://localhost

# Dify API 密钥
VITE_DIFY_API_TOKEN=app-v2ZsPiQjtVqNbtaPBoHvBYvt

# Dify API 用户名
VITE_DIFY_API_USER=Descartes

# ========================================
# 离线模式（仅用于演示，不使用 Ollama 时）
# ========================================

# 当没有配置 Ollama 且 Dify 不可用时，启用离线模拟模式
VITE_OFFLINE_MODE=false
